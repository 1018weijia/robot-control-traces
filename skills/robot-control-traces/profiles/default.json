{
  "name": "default",
  "description": "Framework-independent keyword heuristics. Always applied last; write a specific profile when scan shows wrong roles. MCP tools only act when their server or name is robot-specific; agent-coordination tools are auxiliary.",
  "rules": [
    {
      "label": "view_image",
      "role": "observe",
      "tool": "(^|\\.)view_image$"
    },
    {
      "label": "codex_builtin",
      "role": "aux",
      "kind": "builtin",
      "tool": "^(apply_patch|update_plan|web_search|tool_search|read_file|list_dir|grep_files|list_mcp_resources|list_mcp_resource_templates|read_mcp_resource|spawn_agent|send_input|send_message|wait|wait_agent|close_agent|resume_agent|list_agents|request_user_input|js_repl|view_file)$"
    },
    {
      "label": "agent_tools",
      "role": "aux",
      "tool": "(?i)^(?:multi_agents?\\w*|collaboration|agents?|subagents?|codex\\w*|mcp__codex\\w*)(?:\\.|__)"
    },
    {
      "label": "mcp_observe",
      "role": "observe",
      "kind": "mcp",
      "tool": "(?i)(screenshot|camera|capture|observ|get_obs|get_state|snapshot|image|perceiv|sense|look|render|frame|rgb|depth|pointcloud|lidar|joint_states|pose_get|get_pose)"
    },
    {
      "label": "robot_server_act",
      "role": "act",
      "kind": "mcp",
      "tool": "(?i)^(?:mcp__)?(?:[a-z0-9]+[_-])*(?:robots?|robo|robotics|arms?|ros2?|sim|simulator|simulation|isaac\\w*|mujoco|gazebo|gripper|manipulator|franka|xarm|piper|aloha|lerobot|unitree|panda)(?:[_-][a-z0-9]+)*(?:\\.|__)(?:[a-z0-9]+_)*(?:act|action|step|exec|execute|run|command|cmd|control|send|publish|reset|home|open|close|release|stop|move|grip|gripper|grasp|place|pour|pick|push|pull|lift|lower|rotate|turn|reach|go|goto|navigate|drive|servo|teleop|trajectory|joints?|set|apply|perform|finish|done|submit)(?:_[a-z0-9]+)*$"
    },
    {
      "label": "robot_server_other",
      "role": "observe",
      "kind": "mcp",
      "tool": "(?i)^(?:mcp__)?(?:[a-z0-9]+[_-])*(?:robots?|robo|robotics|arms?|ros2?|sim|simulator|simulation|isaac\\w*|mujoco|gazebo|gripper|manipulator|franka|xarm|piper|aloha|lerobot|unitree|panda)(?:[_-][a-z0-9]+)*(?:\\.|__)"
    },
    {
      "label": "mcp_act",
      "role": "act",
      "kind": "mcp",
      "tool": "(?i)(?:^|\\.|__)(?:[a-z0-9]+_)*(?:gripper|grasp|joints?|arms?|robot|servo|teleop|tcp|end_effector|manipulator|pick_and_place)(?:_[a-z0-9]+)*$"
    },
    {
      "label": "act_code",
      "role": "act",
      "kind": "shell",
      "code": "(?:\\b(?:robo|robot|arm|env|controller|ctrl|bot|agent|sim|policy)\\.(?:move\\w*|step|grip\\w*|set_gripper|grasp|place|pick\\w*|pour|rotate|turn\\w*|push|pull|lift|lower|home|reset|execute\\w*|act|apply_action|send_action|servo\\w*|go_?to\\w*|reach|release|open_gripper|close_gripper|set_joint\\w*|\\w+_execute|\\w+_step|wait)\\s*\\()|(?:\\b(?:move_to|move_by|move_path|move_joints?|set_gripper|open_gripper|close_gripper|pick_up|goto_pose|apply_action|send_action|execute_action|servo_to)\\s*\\()"
    },
    {
      "label": "act_command",
      "role": "act",
      "kind": "shell",
      "command": "\\b(ros2 topic pub|rostopic pub|ros2 action send_goal|rosservice call|ros2 service call|teleop\\w*|robot_cli|send_action|move_to|set_gripper)\\b"
    },
    {
      "label": "observe_code",
      "role": "observe",
      "kind": "shell",
      "code": "\\b(?:get_obs\\w*|get_observation|observe|get_state|state|image|camera\\w*|capture\\w*|snapshot|render|rgb|get_image)\\s*\\("
    },
    {
      "label": "observe_command",
      "role": "observe",
      "kind": "shell",
      "command": "(latest\\.json|observation|camera|\\.png\\b|\\.jpe?g\\b|screenshot|get_obs|rostopic echo|ros2 topic echo|state\\.json)"
    }
  ],
  "rationale_options": [
    "--note",
    "--reason",
    "--evidence",
    "--why",
    "--rationale",
    "--comment",
    "--explanation",
    "--intent",
    "--message"
  ],
  "rationale_keys": [
    "note",
    "reason",
    "evidence",
    "rationale",
    "why",
    "explanation",
    "thought",
    "thinking",
    "comment",
    "intent",
    "description",
    "plan",
    "observation"
  ],
  "code_file_options": [
    "--file",
    "--code",
    "--script",
    "--cell"
  ],
  "action_calls": "(^|\\.)(move\\w*|step|grip\\w*|set_gripper|open_gripper|close_gripper|grasp\\w*|place\\w*|pick\\w*|pour\\w*|rotate\\w*|turn\\w*|push|pull|lift|lower|home|reset|execute\\w*|act|apply_action|send_action|servo\\w*|go_?to\\w*|reach|reach_to|release\\w*|set_joint\\w*|wait|tilt\\w*|insert|press|\\w+_execute|\\w+_step|navigate\\w*|drive)$",
  "probe_calls": "(^|\\.)(state|get_state|get_obs\\w*|observe|reachable|ik\\w*|fk\\w*|project\\w*|back_project|triangulate|ray|annotate|image|camera\\w*|segment\\w*|detect\\w*|locate\\w*|perceive|look\\w*|query\\w*|check\\w*|plan\\w*|preview\\w*|diagnose|\\w*propose\\w*)$"
}
